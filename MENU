# Password operations
password_menu() {
    while true; do
        show_banner
        echo -e "${WHITE}┌────────────────────────────────────────────────────────────────────┐${NC}"
        echo -e "${WHITE}│                    ${YELLOW}PASSWORD OPERATIONS${WHITE}                       │${NC}"
        echo -e "${WHITE}└────────────────────────────────────────────────────────────────────┘${NC}"
        echo ""
        echo -e "${GREEN}  [1]  Reset Windows Password    - Clear admin password (SAM)"
        echo -e "${GREEN}  [2]  Reset Linux Password     - Clear root password"
        echo -e "${GREEN}  [3]  Windows SAM Viewer        - View user accounts"
        echo -e "${GREEN}  [4]  Hash Dumping             - Mimikatz, pwdump, secretsdump"
        echo -e "${GREEN}  [5]  Hash Cracking           - Hashcat, John the Ripper"
        echo -e "${GREEN}  [6]  WiFi Password Recovery   - Find saved WiFi passwords"
        echo -e "${GREEN}  [7]  Rainbow Tables          - Precomputed hash lookup"
        echo -e "${GREEN}  [8]  Password Spraying       - Try common passwords"
        echo ""
        echo -e "${RED}  [B]  Back to main menu${NC}"
        echo ""
        echo -ne "${YELLOW}Select: ${NC}"
        read choice
        case $choice in
            1) bash /scripts-desktop/win-password-reset.sh ;;
            2) echo "Linux password reset: boot to single user mode" ;;
            3) echo "SAM Viewer: chntpw -l /mnt/Windows/System32/config/SAM" ;;
            4) echo "Hash dumping tools..." ;;
            5) echo "Run: hashcat -m 0 hash.txt wordlist.txt" ;;
            6) bash /scripts-desktop/wifi-recovery.sh ;;
            7) echo "Use CrackStation or online tools" ;;
            8) echo "Password spraying..." ;;
            b|B) return ;;
        esac
        echo "Press Enter to continue..."
        read
    done
}

