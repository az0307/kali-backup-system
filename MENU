# Show credentials
show_credentials() {
    echo -e "${GREEN}=======================================${NC}"
    echo -e "${GREEN}     SAVED CREDENTIALS${NC}"
    echo -e "${GREEN}=======================================${NC}"
    cat /wifi-passwords/NETWORK-CREDENTIALS.txt 2>/dev/null || echo "No credentials found"
    echo ""
}

# Show quick reference
show_reference() {
    cat /scripts-desktop/QUICK-REF.txt 2>/dev/null || echo "Reference not found"
}

# Show network status
show_network() {
    echo -e "${GREEN}=== Network Interfaces ===${NC}"
    ip addr 2>/dev/null | grep -E "^[0-9]+:|inet "
    echo ""
    echo -e "${GREEN}=== Routes ===${NC}"
    ip route 2>/dev/null
    echo ""
    echo -e "${GREEN}=== DNS ===${NC}"
    cat /etc/resolv.conf 2>/dev/null | grep nameserver
}

# Main loop
while true; do
    main_menu
    read choice
    case $choice in
        1) password_menu ;;
        2) network_menu ;;
        3) wireless_menu ;;
        4) exploit_menu ;;
        5) echo "Forensics tools..." ;;
        6) bash /scripts-desktop/system-info.sh ;;
        7) echo "Post-exploitation..." ;;
        8) echo "AI tools - see option U" ;;
        a|A) echo "Auto-pentest mode..." ;;
        w|W) airmon-ng start wlan0; airodump-ng wlan0mon ;;
        m|M) airmon-ng start wlan0; echo "Monitor mode: wlan0mon" ;;
        s|S) systemctl start ssh 2>/dev/null; service apache2 start 2>/dev/null; echo "Services started" ;;
        r|R) show_credentials; echo "Press Enter..."; read ;;
        h|H) show_reference; echo "Press Enter..."; read ;;
        n|N) show_network; echo "Press Enter..."; read ;;
        i|I) bash /scripts-desktop/system-info.sh ;;
        d|D) show_device_setups; echo "Press Enter..."; read ;;
        u|U) apt update && apt upgrade -y ;;
        x|X) echo -e "${GREEN}Goodbye!${NC}"; exit 0 ;;
        *) echo "Invalid option" ;;
    esac
done
