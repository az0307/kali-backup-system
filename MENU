NC='\033[0m'

# Check root
if [ "$(id -u)" -ne 0 ]; then
   echo -e "${RED}Please run with sudo: sudo ./MENU${NC}"
   exit 1
fi

# Get system info
get_system_info() {
    OS=$(cat /etc/os-release | grep PRETTY_NAME | cut -d'"' -f2)
    KERNEL=$(uname -r)
    IP=$(ip addr 2>/dev/null | grep "inet " | awk '{print $2}' | head -1)
}

